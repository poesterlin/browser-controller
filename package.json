{
  "name": "browser-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "browserctl": "dist/cli/index.js"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "build": "tsc",
    "compile": "bun build --compile src/cli/index.ts --outfile dist/browserctl",
    "install:binary": "bun run compile && install -m 755 dist/browserctl ~/.local/bin/browserctl",
    "extension:build": "bun scripts/build-extension.ts",
    "test": "bun test src",
    "dev": "BROWSER_CONTROLLER_COMMAND='bun run dev --' bun src/cli/index.ts",
    "start": "bun run build && BROWSER_CONTROLLER_COMMAND='browserctl' bun dist/cli/index.js"
    ,"supervisor": "bun src/cli/index.ts --internal-supervisor"
    ,"fake-adapter": "bun src/adapters/fake-adapter.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "bun-types": "^1.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
